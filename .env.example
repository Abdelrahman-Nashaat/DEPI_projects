# Copy this file to ".env" and fill in your own keys.
# NEVER commit the real .env file (it is listed in .gitignore).

# Groq (key from console.groq.com): used for the fast and smart cloud models
GROQ_API_KEY=your-groq-key-here
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (OPTIONAL cloud backup, key from aistudio.google.com)
# GOOGLE_API_KEY=your-google-key-here
FALLBACK_MODEL=gemini-2.5-flash

# Local model: the last-resort fallback (run: ollama pull qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b
